#!name=AutoSpoofVN Location
#!desc=Chặn Apple Location Server, thay toạ độ giả. Import vào Shadowrocket.
#!homepage=https://github.com/ndh0408/AutoSpoofVN
#!arguments=latitude:21.0285,longitude:105.8542,horizontalAccuracy:39

[Script]
AutoSpoofVN Location = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc,requires-body=1,binary-body-mode=1,max-size=0,timeout=30,script-path=https://raw.githubusercontent.com/ndh0408/AutoSpoofVN/main/Proxy/location-spoofer.js,argument=latitude={{{latitude}}}&longitude={{{longitude}}}&horizontalAccuracy={{{horizontalAccuracy}}}

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
